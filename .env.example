# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up`.

# SQL Server enforces a password complexity policy: 8+ characters, and at
# least 3 of (uppercase, lowercase, digit, symbol). A weak password here will
# make the db container fail to start with a non-obvious error.
MSSQL_SA_PASSWORD=JussyJBoi5677!

# Flask session/JWT signing secret.
SECRET_KEY=816039343
